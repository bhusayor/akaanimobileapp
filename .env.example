# RevenueCat public app keys. Copy to .env.local and replace these values.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_your_public_app_key
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_your_public_app_key

# Akaani platform-api root (no /v1). Turns on real login/signup and sends the
# user's bearer token with Scan Your Meal. On a physical device use your
# computer's LAN IP, not localhost. Scan needs /v1/scan/identify and
# /v1/scan/estimate on the server (contract in src/api/scan.ts).
# EXPO_PUBLIC_PLATFORM_API_URL=http://192.168.1.20:30123
# DEVELOPMENT ONLY: calls OpenAI straight from the device. EXPO_PUBLIC_ values are
# bundled into the app, so this is compiled out of release builds. Never ship it.
# EXPO_PUBLIC_OPENAI_API_KEY=sk-...
# EXPO_PUBLIC_OPENAI_MODEL=gpt-4o-mini
